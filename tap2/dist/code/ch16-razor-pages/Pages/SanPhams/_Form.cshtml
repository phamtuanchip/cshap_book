@* Partial dung chung cho Create va Edit. Model = SanPhamInput; danh sach nhom truyen qua ViewData. *@
@using Microsoft.AspNetCore.Mvc.Rendering
@model SanPhamInput
@{ var nhom = (SelectList)ViewData["Nhom"]!; }

<div asp-validation-summary="ModelOnly" class="loi"></div>

<div class="truong">
    <label asp-for="Ma"></label>
    <input asp-for="Ma" />
    <span asp-validation-for="Ma" class="loi"></span>
</div>
<div class="truong">
    <label asp-for="Ten"></label>
    <input asp-for="Ten" />
    <span asp-validation-for="Ten" class="loi"></span>
</div>
<div class="truong">
    <label asp-for="NhomId"></label>
    <select asp-for="NhomId" asp-items="nhom">
        <option value="0">-- Chọn nhóm --</option>
    </select>
    <span asp-validation-for="NhomId" class="loi"></span>
</div>
<div class="truong">
    <label asp-for="Gia"></label>
    <input asp-for="Gia" />
    <span asp-validation-for="Gia" class="loi"></span>
</div>
<div class="truong">
    <label asp-for="Ton"></label>
    <input asp-for="Ton" />
    <span asp-validation-for="Ton" class="loi"></span>
</div>
