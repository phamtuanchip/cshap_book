@model DanhSachSanPhamViewModel
@{
    ViewData["Title"] = "Sản phẩm";
}

<h1>Sản phẩm</h1>

<form method="get" asp-action="Index" class="tim-kiem">
    <input type="search" name="tuKhoa" value="@Model.TuKhoa" placeholder="Tìm theo tên hoặc mã…" />
    <button type="submit">Tìm</button>
</form>

@if (Model.SanPhams.Count == 0)
{
    <p><em>Không có sản phẩm nào.</em></p>
}
else
{
    <table>
        <thead><tr><th>Mã</th><th>Tên</th><th class="so">Giá</th><th class="so">Tồn</th><th></th></tr></thead>
        <tbody>
        @foreach (var sp in Model.SanPhams)
        {
            <tr class="@(sp.Ton == 0 ? "het-hang" : null)">
                <td>@sp.Ma</td>
                <td><a asp-action="Details" asp-route-id="@sp.Id">@sp.Ten</a></td>
                <td class="so">@sp.Gia.ToString("N0")</td>
                <td class="so">@sp.Ton</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@sp.Id">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@sp.Id">Xoá</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav class="phan-trang" aria-label="Phân trang">
        @if (Model.Trang > 1)
        {
            <a asp-action="Index" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trang="@(Model.Trang - 1)">« Trước</a>
        }
        <span>Trang @Model.Trang / @Model.TongTrang</span>
        @if (Model.Trang < Model.TongTrang)
        {
            <a asp-action="Index" asp-route-tuKhoa="@Model.TuKhoa" asp-route-trang="@(Model.Trang + 1)">Sau »</a>
        }
    </nav>
}
